실행 순서
bash# p-dep 서버에서
# 1. WinRM 연결 테스트
ansible windows -i inventory/dev.ini -m win_ping

# 2. 전체 배포
ansible-playbook -i inventory/dev.ini deploy.yml

# 3. 특정 태그만 실행 (nginx 재설치 없이 vue만 재배포)
