3. roles/nginx_vue3/tasks/main.yml
yaml- name: Nginx 다운로드 디렉토리 생성
  win_file:
    path: "{{ nginx_install_dir }}"
    state: directory

- name: Nginx for Windows 다운로드
  win_get_url:
    url: "https://nginx.org/download/nginx-{{ nginx_version }}.zip"
    dest: "C:\\Temp\\nginx-{{ nginx_version }}.zip"

- name: Nginx 압축 해제
  win_unzip:
    src: "C:\\Temp\\nginx-{{ nginx_version }}.zip"
    dest: "E:\\"
    creates: "{{ nginx_install_dir }}\\nginx.exe"

- name: 압축 해제된 폴더명 정리 (rename)
  win_shell: |
    if (Test-Path "E:\nginx-{{ nginx_version }}") {
      Rename-Item "E:\nginx-{{ nginx_version }}" "nginx"
    }

- name: nginx.conf 배포
  win_template:
    src: nginx.conf.j2
    dest: "{{ nginx_install_dir }}\\conf\\nginx.conf"

- name: Vue3 dist 파일 복사
  win_copy:
    src: files/dist/
    dest: "{{ vue3_dist_dir }}\\"

- name: Nginx Windows Service 등록 (NSSM 사용)
  win_shell: |
    if (-not (Get-Service -Name "nginx" -ErrorAction SilentlyContinue)) {
      sc.exe create nginx binPath= "{{ nginx_install_dir }}\nginx.exe" start= auto
    }

- name: Nginx 서비스 시작
  win_service:
    name: nginx
    state: started
    start_mode: auto

- name: 방화벽 포트 오픈
  win_firewall_rule:
    name: "Nginx HTTP"
    localport: "{{ nginx_port }}"
    action: allow
    direction: in
    protocol: tcp
    state: present
    enabled: yes

- name: 헬스체크
  win_uri:
    url: "http://localhost:{{ nginx_port }}"
    status_code: 200
  register: result
  retries: 3
  delay: 5

