2. group_vars/windows.yml
yamlnginx_version: "1.26.1"
nginx_install_dir: "E:\\nginx"
vue3_dist_dir: "E:\\nginx\\html"
nginx_port: 80
app_name: "hiware-front"

3. roles/nginx_vue3/tasks/main.yml
yaml- name: Nginx 다운로드 디렉토리 생성
  win_file:
    path: "{{ nginx_install_dir }}"
    state: directory

- name: Nginx for Windows 다운로드
  win_get_url:
    url: "https://nginx.org/download/nginx-{{ nginx_version }}.zip"
    dest: "C:\\Temp\\nginx-{{ nginx_version }}.zip"

- name: Nginx 압축 해제
  win_unzip:
    src: "C:\\Temp\\nginx-{{ nginx_version }}.zip"
    dest: "E:\\"
    creates: "{{ nginx_install_dir }}\\nginx.exe"

- name: 압축 해제된 폴더명 정리 (rename)
  win_shell: |
    if (Test-Path "E:\nginx-{{ nginx_version }}") {
      Rename-Item "E:\nginx-{{ nginx_version }}" "nginx"
    }

- name: nginx.conf 배포
  win_template:
    src: nginx.conf.j2
    dest: "{{ nginx_install_dir }}\\conf\\nginx.conf"

- name: Vue3 dist 파일 복사
  win_copy:
    src: files/dist/
    dest: "{{ vue3_dist_dir }}\\"

- name: Nginx Windows Service 등록 (NSSM 사용)
  win_shell: |
    if (-not (Get-Service -Name "nginx" -ErrorAction SilentlyContinue)) {
      sc.exe create nginx binPath= "{{ nginx_install_dir }}\nginx.exe" start= auto
    }

- name: Nginx 서비스 시작
  win_service:
    name: nginx
    state: started
    start_mode: auto

- name: 방화벽 포트 오픈
  win_firewall_rule:
    name: "Nginx HTTP"
    localport: "{{ nginx_port }}"
    action: allow
    direction: in
    protocol: tcp
    state: present
    enabled: yes

- name: 헬스체크
  win_uri:
    url: "http://localhost:{{ nginx_port }}"
    status_code: 200
  register: result
  retries: 3
  delay: 5

4. roles/nginx_vue3/templates/nginx.conf.j2
nginxworker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout  65;

    server {
        listen       {{ nginx_port }};
        server_name  localhost;

        root   html;
        index  index.html;

        # Vue3 SPA - 새로고침 대응
        location / {
            try_files $uri $uri/ /index.html;
        }

        # API reverse proxy (백엔드 연동 시 주석 해제)
        # location /api/ {
        #     proxy_pass http://개발서버_IP:8080/;
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        # }

        error_page   500 502 503 504  /50x.html;
    }
}

5. deploy.yml (메인 playbook)
yaml- name: Vue3 + Nginx 배포 (Windows)
  hosts: windows
  gather_facts: yes
  roles:
    - nginx_vue3

실행 순서
bash# p-dep 서버에서
# 1. WinRM 연결 테스트
ansible windows -i inventory/dev.ini -m win_ping

# 2. 전체 배포
ansible-playbook -i inventory/dev.ini deploy.yml

# 3. 특정 태그만 실행 (nginx 재설치 없이 vue만 재배포)
ansible-playbook -i inventory/dev.ini deploy.yml --tags vue3

주의사항
항목내용WinRM 사전 설정대상 VM에서 winrm quickconfig 실행 필요NSSM 권장sc.exe로 등록한 nginx는 재시작 정책이 약함 → 운영 전환 시 NSSM으로 교체 권장Vue3 빌드npm run build 후 dist/ 폴더를 roles/nginx_vue3/files/dist/에 넣고 실행Nginx 경로Windows는 경로에 역슬래시(\) 사용, conf 파일 내부는 슬래시(/) 사용
Nginx 역할(정적 서빙 vs API proxy)이 확정되면 nginx.conf.j2 부분 더 구체화해드릴 수 있어요.
