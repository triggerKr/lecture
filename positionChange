-- 1) 원하는 컬럼 순서로 새 테이블 생성
CREATE TABLE TB_ROLE_MENU_AUTH_NEW (
    ROLE_ID     VARCHAR2(100)         NOT NULL,
    MENU_ID     NUMBER                NOT NULL,
    USE_YN      CHAR(1) DEFAULT 'N',
    READ_YN     CHAR(1) DEFAULT 'N',
    CREATE_YN   CHAR(1) DEFAULT 'N',
    UPDATE_YN   CHAR(1) DEFAULT 'N'   NOT NULL,
    DELETE_YN   CHAR(1) DEFAULT 'N'   NOT NULL,
    EXCEL_YN    CHAR(1) DEFAULT 'N',
    CREATE_BY   VARCHAR2(100),
    CREATE_DATE DATE DEFAULT SYSDATE,
    CONSTRAINT PK_TB_ROLE_MENU_AUTH_NEW PRIMARY KEY (ROLE_ID, MENU_ID)
) TABLESPACE USERS;

-- 2) 기존 데이터를 컬럼명 지정해서 그대로 복사 (물리적 순서와 무관하게 안전)
INSERT INTO TB_ROLE_MENU_AUTH_NEW
    (ROLE_ID, MENU_ID, USE_YN, READ_YN, CREATE_YN, UPDATE_YN, DELETE_YN, EXCEL_YN, CREATE_BY, CREATE_DATE)
SELECT
    ROLE_ID, MENU_ID, USE_YN, READ_YN, CREATE_YN, UPDATE_YN, DELETE_YN, EXCEL_YN, CREATE_BY, CREATE_DATE
FROM TB_ROLE_MENU_AUTH;

COMMIT;

-- 3) *** 반드시 행 개수가 같은지 확인 후 다음 단계로 진행하세요 ***
SELECT (SELECT COUNT(*) FROM TB_ROLE_MENU_AUTH)     AS OLD_CNT,
       (SELECT COUNT(*) FROM TB_ROLE_MENU_AUTH_NEW) AS NEW_CNT
FROM DUAL;

-- 4) 개수가 일치하면, 기존 테이블은 바로 지우지 말고 이름만 백업용으로 변경
RENAME TB_ROLE_MENU_AUTH TO TB_ROLE_MENU_AUTH_OLD_BAK;

-- 5) 새 테이블을 원래 이름으로 변경
RENAME TB_ROLE_MENU_AUTH_NEW TO TB_ROLE_MENU_AUTH;

-- (선택) 제약조건 이름을 기존 관례(SYS_C...)에 맞추고 싶다면
ALTER TABLE TB_ROLE_MENU_AUTH RENAME CONSTRAINT PK_TB_ROLE_MENU_AUTH_NEW TO PK_TB_ROLE_MENU_AUTH;

