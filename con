stage('Check Java Certificates') {
    steps {
        script {
            // 젠킨스 에이전트가 인식하는 java.home 위치에서 cacerts 경로를 찾습니다.
            sh '''
                echo "=== Java Home 경로 확인 ==="
                java -XshowSettings:properties -version 2>&1 | grep java.home
                
                echo "=== cacerts 내부 Nexus 인증서 검색 ==="
                # 인증서 저장소 위치를 찾아 grep으로 검색합니다.
                # 기본 비밀번호인 changeit을 사용합니다.
                if [ -d "$JAVA_HOME" ]; then
                    TARGET_CA="$JAVA_HOME/lib/security/cacerts"
                else
                    TARGET_CA=$(readlink -f $(which java) | sed "s:/bin/java::")/lib/security/cacerts
                fi
                
                if [ -f "$TARGET_CA" ]; then
                    keytool -list -keystore "$TARGET_CA" -storepass changeit | grep -i "nexus" || echo "❌ Nexus 인증서를 찾을 수 없습니다."
                else
                    echo "❌ cacerts 파일을 찾을 수 없습니다 경로를 확인하세요."
                fi
            '''
        }
    }
}
