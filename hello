@echo off
setlocal enabledelayedexpansion

:: 로그를 기록할 파일 경로 (원하는 경로로 수정 가능)
set "LOG_FILE=C:\MyService\service_log.txt"

:: 서비스 시작 로그 기록
echo [%date% %time%] === HelloService가 시작되었습니다 === >> "%LOG_FILE%"

:loop
:: 현재 분(mm)과 초(ss)를 추출
set "current_time=%time%"
set "mm=%current_time:~3,2%"
set "ss=%current_time:~6,2%"

:: 1. 분과 초가 모두 "00"인 정각인지 체크 (혹은 딜레이로 인한 누락 방지를 위해 02초까지 허용)
if "%mm%"=="00" (
    if "%ss%"=="00" set "match=1"
    if "%ss%"=="01" set "match=1"
    if "%ss%"=="02" set "match=1"
) else (
    set "match=0"
)

:: 2. 정각이 맞다면 로직 실행 및 로그 기록
if "!match!"=="1" (
    :: 화면엔 안 보이지만 서비스 내부적으로 hello 출력
    echo hello 
    
    :: [모니터링용] 사용자가 눈으로 확인할 수 있게 파일에 기록
    echo [%date% %time%] hello - 정상 실행됨 >> "%LOG_FILE%"
    
    :: 중복 실행을 막기 위해 5초 동안 완전히 쉬어줍니다.
    timeout /t 5 /nobreak > nul
)

:: 3. 시스템 부하를 줄이기 위해 0.5초마다 시간 감시 (무한 루프)
timeout /t 1 /nobreak > nul
goto loop
