MERGE INTO TB_ROLE_MENU_AUTH tgt
USING (
    SELECT r.ROLE_ID, m.MENU_ID
    FROM TB_ROLE r
    CROSS JOIN TB_MENU m
) src
ON (tgt.ROLE_ID = src.ROLE_ID AND tgt.MENU_ID = src.MENU_ID)
WHEN MATCHED THEN
    UPDATE SET
        USE_YN    = 'Y',
        READ_YN   = 'Y',
        CREATE_YN = 'Y',
        UPDATE_YN = 'Y',
        DELETE_YN = 'Y',
        EXCEL_YN  = 'Y'
WHEN NOT MATCHED THEN
    INSERT (ROLE_ID, MENU_ID, USE_YN, READ_YN, CREATE_YN, UPDATE_YN, DELETE_YN, EXCEL_YN, CREATE_BY, CREATE_DATE)
    VALUES (src.ROLE_ID, src.MENU_ID, 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'ADMIN', SYSDATE);

COMMIT;




MERGE INTO TB_ROLE_MENU_AUTH tgt
USING (
    SELECT MENU_ID FROM TB_MENU
) src
ON (tgt.ROLE_ID = 'ROLE_DEV' AND tgt.MENU_ID = src.MENU_ID)
WHEN MATCHED THEN
    UPDATE SET
        USE_YN    = 'Y',
        READ_YN   = 'Y',
        CREATE_YN = 'Y',
        UPDATE_YN = 'Y',
        DELETE_YN = 'Y',
        EXCEL_YN  = 'Y'
WHEN NOT MATCHED THEN
    INSERT (ROLE_ID, MENU_ID, USE_YN, READ_YN, CREATE_YN, UPDATE_YN, DELETE_YN, EXCEL_YN, CREATE_BY, CREATE_DATE)
    VALUES ('ROLE_DEV', src.MENU_ID, 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'ADMIN', SYSDATE);

COMMIT;
